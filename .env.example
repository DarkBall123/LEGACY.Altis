# HEMTT executable or absolute path.
HEMTT_BIN=hemtt

# HEMTT release used by GitHub Actions.
HEMTT_VERSION=v1.19.1
HEMTT_LINUX_SHA256=d503b42b71eb00ec31cca70268896769294aa96d18c1c786bfe3267681ba4d7f

# Arguments passed to `hemtt build` by the mission PBO packer.
HEMTT_BUILD_ARGS="--no-bin --no-rap"

# Final file name is `${MISSION_PBO_NAME}.pbo`.
# Keep the terrain suffix required by Arma 3, for example `.Altis`.
MISSION_PBO_NAME=ChudoYudo.yulakia
MISSION_OUTPUT_DIR=.hemttout

# FTP deployment target. Store real credentials in `.env` locally and in
# GitHub Actions Secrets for CD.
DEPLOY_PROTOCOL=ftp
DEPLOY_HOST=ftp.example.com
DEPLOY_PORT=21
DEPLOY_USER=ftp-user
DEPLOY_PASSWORD=
DEPLOY_FTP_PASSIVE=true

# `off`, `try`, or `require`. Use `require` when the provider supports FTPS.
DEPLOY_FTP_TLS=try
DEPLOY_FTP_TLS_VERIFY=true
# Optional SHA-256 certificate pin, useful with a provider's self-signed FTPS cert.
DEPLOY_FTP_TLS_CERT_SHA256=

# Directory containing Arma 3 mission PBO files on the hosting account.
DEPLOY_REMOTE_MISSIONS_DIR=/MPMissions

# Preserve the previous PBO as `${MISSION_PBO_NAME}.pbo.<timestamp>.bak`.
DEPLOY_BACKUP_EXISTING=true
# Maximum number of timestamped mission PBO backups kept on the host.
DEPLOY_BACKUP_KEEP=3
